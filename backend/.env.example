# Reflex Delivery Tracker - Backend Environment Variables
# Copy this to .env and fill in the real values.
# Never commit .env to version control.

# Option 1: Full PostgreSQL connection URL (common on Render / Railway / Supabase)
# DATABASE_URL=postgresql://postgres:password@host:5432/reflex

# Option 2: Individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=reflex

# Connection pool tuning (optional, defaults to 5 / 20)
DB_MIN_SIZE=5
DB_MAX_SIZE=20

# CORS Allowed Origins (comma-separated, e.g. "https://your-app.onrender.com,http://localhost:5173" or "*" for dev)
ALLOWED_ORIGINS=*
